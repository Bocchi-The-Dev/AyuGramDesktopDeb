name: Linux Build & Release

on:
  schedule:
    - cron: "*/15 * * * *"
  workflow_dispatch:
    inputs:
      debug:
        description: "Build Debug instead of Release"
        type: boolean
        default: false
      force_build:
        description: "Force build even if no new commits/tags"
        type: boolean
        default: false

jobs:
  build:
    name: Build AyuGram Linux (x86_64)
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Get latest AyuGram info via API
        id: ayugram_info
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          STABLE_TAG=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
            https://api.github.com/repos/AyuGram/AyuGramDesktop/releases/latest | jq -r '.tag_name')
          if [ "$STABLE_TAG" == "null" ] || [ -z "$STABLE_TAG" ]; then
            STABLE_TAG=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
              https://api.github.com/repos/AyuGram/AyuGramDesktop/tags | jq -r '.[0].name')
          fi
          echo "stable_tag=$STABLE_TAG" >> $GITHUB_OUTPUT

          DEV_COMMIT=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
            https://api.github.com/repos/AyuGram/AyuGramDesktop/commits/dev | jq -r '.sha[:7]')
          echo "dev_commit=$DEV_COMMIT" >> $GITHUB_OUTPUT

      - name: Read tracking files
        id: track
        run: |
          echo "stored_stable=$(cat stable_version.txt 2>/dev/null || echo '')" >> $GITHUB_OUTPUT
          echo "stored_nightly=$(cat nightly_commit.txt 2>/dev/null || echo '')" >> $GITHUB_OUTPUT

      - name: Determine if build is needed
        id: build_needed
        run: |
          STABLE="${{ steps.ayugram_info.outputs.stable_tag }}"
          NIGHTLY="${{ steps.ayugram_info.outputs.dev_commit }}"
          STORED_STABLE="${{ steps.track.outputs.stored_stable }}"
          STORED_NIGHTLY="${{ steps.track.outputs.stored_nightly }}"
          FORCE="${{ github.event.inputs.force_build }}"

          if [ "$FORCE" == "true" ]; then
            echo "should_build=true" >> $GITHUB_OUTPUT
          elif [ "$STABLE" != "$STORED_STABLE" ] || [ "$NIGHTLY" != "$STORED_NIGHTLY" ]; then
            echo "should_build=true" >> $GITHUB_OUTPUT
          else
            echo "should_build=false" >> $GITHUB_OUTPUT
          fi

      - name: Checkout AyuGram source
        if: steps.build_needed.outputs.should_build == 'true'
        uses: actions/checkout@v4
        with:
          repository: AyuGram/AyuGramDesktop
          submodules: recursive
          path: source
          fetch-depth: 0

      - name: Cache ccache
        if: steps.build_needed.outputs.should_build == 'true'
        uses: actions/cache@v4
        with:
          path: ~/.ccache
          key: ccache-${{ runner.os }}-ayugram
          restore-keys: ccache-${{ runner.os }}-

      - name: Prepare ccache directory
        if: steps.build_needed.outputs.should_build == 'true'
        run: mkdir -p ~/.ccache

      # ── stable ────────────────────────────────────────────────────────────

      - name: Build stable from tag
        if: >
          steps.build_needed.outputs.should_build == 'true' &&
          steps.ayugram_info.outputs.stable_tag != 'null' &&
          steps.ayugram_info.outputs.stable_tag != ''
        env:
          BUILD_TYPE: ${{ github.event.inputs.debug == 'true' && 'Debug' || 'Release' }}
        run: |
          cd source
          git checkout ${{ steps.ayugram_info.outputs.stable_tag }}
          docker run --rm \
            -u $(id -u) \
            -v "$PWD:/usr/src/tdesktop" \
            -v "$HOME/.ccache:/home/user/.ccache" \
            ghcr.io/telegramdesktop/tdesktop/centos_env:latest \
            /usr/src/tdesktop/Telegram/build/docker/centos_env/build.sh \
            -D TDESKTOP_API_ID=${{ secrets.TDESKTOP_API_ID }} \
            -D TDESKTOP_API_HASH=${{ secrets.TDESKTOP_API_HASH }} \
            -D LTO=ON \
            -D CMAKE_BUILD_TYPE=${BUILD_TYPE}
          strip --strip-all "out/${BUILD_TYPE}/AyuGram"

      - name: Package stable .deb
        if: >
          steps.build_needed.outputs.should_build == 'true' &&
          steps.ayugram_info.outputs.stable_tag != 'null' &&
          steps.ayugram_info.outputs.stable_tag != ''
        run: |
          TAG="${{ steps.ayugram_info.outputs.stable_tag }}"
          VERSION="${TAG#v}"
          BUILD_TYPE="${{ github.event.inputs.debug == 'true' && 'Debug' || 'Release' }}"
          BINARY="source/out/${BUILD_TYPE}/AyuGram"
          PKG="pkg-stable"
          DEB="ayugram-desktop_${VERSION}_amd64.deb"

          # binary
          install -Dm755 "${BINARY}" "${PKG}/usr/bin/ayugram-desktop"

          # icon (pulled from source tree)
          if [ -f source/Telegram/Resources/icons/icon256.png ]; then
            install -Dm644 source/Telegram/Resources/icons/icon256.png \
              "${PKG}/usr/share/icons/hicolor/256x256/apps/ayugram-desktop.png"
          fi

          # .desktop entry
          mkdir -p "${PKG}/usr/share/applications"
          printf '%s\n' \
            '[Desktop Entry]' \
            'Name=AyuGram Desktop' \
            'Comment=Telegram client with ghost mode and message history' \
            'Exec=ayugram-desktop -- %u' \
            'Icon=ayugram-desktop' \
            'Terminal=false' \
            'Type=Application' \
            'Categories=Network;InstantMessaging;' \
            'MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;' \
            'StartupWMClass=AyuGram' \
            > "${PKG}/usr/share/applications/ayugram-desktop.desktop"

          # measure installed size before writing DEBIAN/
          SIZE_KB=$(du -sk "${PKG}" | cut -f1)

          # control file — no leading whitespace on any field line
          mkdir -p "${PKG}/DEBIAN"
          printf '%s\n' \
            "Package: ayugram-desktop" \
            "Version: ${VERSION}" \
            "Architecture: amd64" \
            "Maintainer: AyuGram Community <noreply@ayugram.one>" \
            "Installed-Size: ${SIZE_KB}" \
            "Depends: libc6" \
            "Section: net" \
            "Priority: optional" \
            "Homepage: https://github.com/AyuGram/AyuGramDesktop" \
            "Description: AyuGram Desktop - Telegram fork" \
            " Telegram client with ghost mode, deleted-message history," \
            " message filters, and extensive customization." \
            > "${PKG}/DEBIAN/control"

          dpkg-deb --build --root-owner-group "${PKG}" "${DEB}"
          echo "stable_deb=${DEB}" >> $GITHUB_ENV

      # ── nightly ───────────────────────────────────────────────────────────

      - name: Build nightly from dev
        if: steps.build_needed.outputs.should_build == 'true'
        env:
          BUILD_TYPE: ${{ github.event.inputs.debug == 'true' && 'Debug' || 'Release' }}
        run: |
          cd source
          git checkout dev
          docker run --rm \
            -u $(id -u) \
            -v "$PWD:/usr/src/tdesktop" \
            -v "$HOME/.ccache:/home/user/.ccache" \
            ghcr.io/telegramdesktop/tdesktop/centos_env:latest \
            /usr/src/tdesktop/Telegram/build/docker/centos_env/build.sh \
            -D TDESKTOP_API_ID=${{ secrets.TDESKTOP_API_ID }} \
            -D TDESKTOP_API_HASH=${{ secrets.TDESKTOP_API_HASH }} \
            -D LTO=ON \
            -D CMAKE_BUILD_TYPE=${BUILD_TYPE}
          strip --strip-all "out/${BUILD_TYPE}/AyuGram"

      - name: Package nightly .deb
        if: steps.build_needed.outputs.should_build == 'true'
        run: |
          COMMIT="${{ steps.ayugram_info.outputs.dev_commit }}"
          DATE=$(date -u +%Y%m%d)
          # 0~gitYYYYMMDD+HASH sorts before any real version — correct for a pre-release
          VERSION="0~git${DATE}+${COMMIT}"
          BUILD_TYPE="${{ github.event.inputs.debug == 'true' && 'Debug' || 'Release' }}"
          BINARY="source/out/${BUILD_TYPE}/AyuGram"
          PKG="pkg-nightly"
          DEB="ayugram-desktop_${VERSION}_amd64.deb"

          install -Dm755 "${BINARY}" "${PKG}/usr/bin/ayugram-desktop"

          if [ -f source/Telegram/Resources/icons/icon256.png ]; then
            install -Dm644 source/Telegram/Resources/icons/icon256.png \
              "${PKG}/usr/share/icons/hicolor/256x256/apps/ayugram-desktop.png"
          fi

          mkdir -p "${PKG}/usr/share/applications"
          printf '%s\n' \
            '[Desktop Entry]' \
            'Name=AyuGram Desktop (Nightly)' \
            'Comment=Telegram client with ghost mode and message history' \
            'Exec=ayugram-desktop -- %u' \
            'Icon=ayugram-desktop' \
            'Terminal=false' \
            'Type=Application' \
            'Categories=Network;InstantMessaging;' \
            'MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;' \
            'StartupWMClass=AyuGram' \
            > "${PKG}/usr/share/applications/ayugram-desktop.desktop"

          SIZE_KB=$(du -sk "${PKG}" | cut -f1)

          mkdir -p "${PKG}/DEBIAN"
          printf '%s\n' \
            "Package: ayugram-desktop" \
            "Version: ${VERSION}" \
            "Architecture: amd64" \
            "Maintainer: AyuGram Community <noreply@ayugram.one>" \
            "Installed-Size: ${SIZE_KB}" \
            "Depends: libc6" \
            "Section: net" \
            "Priority: optional" \
            "Homepage: https://github.com/AyuGram/AyuGramDesktop" \
            "Description: AyuGram Desktop - Telegram fork (nightly)" \
            " Telegram client with ghost mode, deleted-message history," \
            " message filters, and customization. Nightly build from dev branch." \
            > "${PKG}/DEBIAN/control"

          dpkg-deb --build --root-owner-group "${PKG}" "${DEB}"
          echo "nightly_deb=${DEB}" >> $GITHUB_ENV

      # ── tracking + release ────────────────────────────────────────────────

      - name: Update tracking files
        if: steps.build_needed.outputs.should_build == 'true'
        run: |
          echo "${{ steps.ayugram_info.outputs.stable_tag }}" > stable_version.txt
          echo "${{ steps.ayugram_info.outputs.dev_commit }}" > nightly_commit.txt
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add stable_version.txt nightly_commit.txt
          if git commit -m "chore: update tracking to stable ${{ steps.ayugram_info.outputs.stable_tag }}, nightly ${{ steps.ayugram_info.outputs.dev_commit }}"; then
            git push
          fi

      - name: Create stable release
        if: >
          steps.build_needed.outputs.should_build == 'true' &&
          steps.ayugram_info.outputs.stable_tag != 'null' &&
          steps.ayugram_info.outputs.stable_tag != ''
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          TAG="${{ steps.ayugram_info.outputs.stable_tag }}"
          if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" &>/dev/null; then
            echo "Release $TAG already exists, skipping."
          else
            gh release create "$TAG" \
              --repo "$GITHUB_REPOSITORY" \
              --title "AyuGram $TAG" \
              --notes "Stable release built from official tag $TAG." \
              "${{ env.stable_deb }}"
          fi

      - name: Publish/update nightly release
        if: steps.build_needed.outputs.should_build == 'true'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          if [ -f "${{ env.nightly_deb }}" ]; then
            gh release delete nightly --repo "$GITHUB_REPOSITORY" -y 2>/dev/null || true
            gh release create nightly \
              --repo "$GITHUB_REPOSITORY" \
              --prerelease \
              --title "Nightly (${{ steps.ayugram_info.outputs.dev_commit }})" \
              --notes "Built from AyuGram dev branch, commit ${{ steps.ayugram_info.outputs.dev_commit }}." \
              "${{ env.nightly_deb }}"
          else
            echo "Nightly .deb not found, skipping."
          fi
